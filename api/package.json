{
  "name": "seid-api",
  "version": "1.0.0",
  "description": "API de SEID (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply seid-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply seid-db --remote",
    "test": "vitest run && vitest run -c vitest.node.config.ts",
    "test:worker": "vitest run",
    "test:node": "vitest run -c vitest.node.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "create-user": "node scripts/create-user.mjs",
    "gen-vapid": "node scripts/gen-vapid.mjs",
    "deploy": "wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "hono": "^4.13.23"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.10.0",
    "@cloudflare/workers-types": "^5.20261127.1",
    "http_ece": "^1.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "web-push": "^3.6.7",
    "wrangler": "^4.169.0"
  },
  "allowScripts": {
    "workerd@1.20261127.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true
  },
  "private": true
}
